{
  "taxRates": { "UK": 0.2, "Germany": 0.25, "Brazil": 0.15 },
  "aiCheck": { "upThreshold": 0.4, "downThreshold": 0.3 },
  "raiseWithoutSourceThreshold": 0.1,
  "requiredFields": {
    "UK": ["NI number", "Sort code", "Bank account"],
    "Germany": ["Tax ID", "IBAN"],
    "Brazil": ["CPF", "Bank account"]
  },
  "requiredFieldsByCountry": {
    "UK": [
      { "field": "NI number", "owner": "employee" },
      { "field": "Sort code", "owner": "employee" },
      { "field": "Bank account", "owner": "employee" },
      { "field": "Manager", "owner": "hr" },
      { "field": "Start date", "owner": "hr" },
      { "field": "Salary", "owner": "hr" }
    ],
    "Germany": [
      { "field": "Tax ID", "owner": "employee" },
      { "field": "IBAN", "owner": "employee" },
      { "field": "Manager", "owner": "hr" },
      { "field": "Start date", "owner": "hr" },
      { "field": "Salary", "owner": "hr" }
    ],
    "Brazil": [
      { "field": "CPF", "owner": "employee" },
      { "field": "Bank account", "owner": "employee" },
      { "field": "Manager", "owner": "hr" },
      { "field": "Start date", "owner": "hr" },
      { "field": "Salary", "owner": "hr" }
    ]
  },
  "employeeOwnedFields": ["Tax ID", "CPF", "Bank account", "NI number", "Sort code", "IBAN"],
  "hrOwnedFields": ["Manager", "Start date", "Salary"],
  "fieldFormats": {
    "CPF": { "pattern": "^[0-9]{11}$", "hint": "11 digits", "strip": "[.\\-\\s]" },
    "Tax ID": { "pattern": "^[0-9]{11}$", "hint": "11 digits", "strip": "\\s" },
    "Bank account": { "pattern": "^[0-9]{8,18}$", "hint": "8–18 digits", "strip": "\\s" },
    "NI number": { "pattern": "^[A-Za-z]{2}[0-9]{6}[A-Za-z]$", "hint": "2 letters, 6 digits, 1 letter", "strip": "\\s" },
    "Sort code": { "pattern": "^[0-9]{6}$", "hint": "6 digits", "strip": "[\\-\\s]" },
    "IBAN": { "pattern": "^[A-Za-z]{2}[0-9]{2}[A-Za-z0-9]{11,30}$", "hint": "IBAN", "strip": "\\s" }
  },
  "daysInMonth": 30,
  "oneTimePaymentTypes": ["Bonus", "Reimbursement", "Arrears", "Other"],
  "extractionTimeoutSeconds": 8
}
