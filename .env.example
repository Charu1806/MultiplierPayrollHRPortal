# Frontend talks to the Flask API via the Vite proxy at /api
VITE_CLARITY_API_BASE=/api

# Optional — Google Picker (Drive). Without these, the UI offers "Upload from computer instead".
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Optional — LLM for document field mapping + Review approve/hold decisions.
# Without LLM_API_KEY, Review uses a soft fallback (document present → lean approve).
#
# Anthropic (Opus) — recommended for this prototype:
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-4-5
LLM_BASE_URL=https://api.anthropic.com
#
# OpenAI alternative:
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
DEMO_FALLBACK=true

# Optional — real employee reminder emails (Gmail SMTP + app password).
# When set, Remind employee sends mail to DEMO_INBOX plus-aliases (you+lena@gmail.com).
# Without these, Remind still works: Notifications get the email + form link + "Email not sent – SMTP not set up".
SMTP_USER=
SMTP_PASS=
DEMO_INBOX=
APP_BASE_URL=http://localhost:5173
FORM_TOKEN_SECRET=
